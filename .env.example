DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/ironfit
# disable | require (encrypted, no cert check) | verify (default in production)
DATABASE_SSL=verify
SECURITY_PEPPER=replace-with-a-long-random-secret-at-least-32-chars
SESSION_COOKIE_NAME=ironfit_session
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Exercise videos: stored on local disk (use a persistent volume in production)
UPLOAD_DIR=./storage
VIDEO_MAX_MB=200
SEED_COACH_EMAIL=coach@example.com
SEED_COACH_PASSWORD=change-this-password
SEED_MEMBER_NAME="Demo Member"
SEED_MEMBER_EMAIL=member@example.com
SEED_MEMBER_PASSWORD=change-this-member-password
